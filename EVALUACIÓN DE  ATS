<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Evaluación de ATS / AST - SSOMA Cielo</title>
    <!-- Tailwind CSS y Google Fonts -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; background: #e0f2fe; }
        .tab-content { display: none; }
        .tab-content.active { display: block; animation: fadeIn 0.3s ease-in-out; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }
    </style>
</head>
<body class="text-slate-700 antialiased flex justify-center min-h-screen p-0 sm:py-6">

    <!-- Contenedor Principal Estilo Smartphone -->
    <div class="w-full max-w-md bg-white min-h-screen sm:min-h-[850px] sm:rounded-3xl shadow-2xl border border-sky-100 flex flex-col justify-between overflow-hidden relative">
        
        <!-- Header Llamativo en Tonos Celestes / Azules -->
        <header class="bg-gradient-to-r from-sky-500 via-sky-600 to-blue-600 p-5 pb-4 sticky top-0 z-50 shadow-md">
            <div class="flex justify-between items-center">
                <div>
                    <span class="text-[10px] uppercase tracking-widest bg-white/20 px-2.5 py-1 rounded-full text-sky-50 font-extrabold backdrop-blur-md">Ref: PG-SSO-04-F2</span>
                    <h1 class="text-lg font-extrabold mt-1 tracking-tight text-white flex items-center gap-1.5">
                        🛡️ Evaluación ATS / AST
                    </h1>
                </div>
                <div class="text-right bg-white/15 px-3 py-1.5 rounded-2xl backdrop-blur-md border border-white/20">
                    <span id="headerScore" class="text-xl font-black text-amber-200">0</span>
                    <span class="text-[10px] text-sky-100 block font-semibold">/ 55 Pts</span>
                </div>
            </div>

            <!-- Navegación por Pestañas (Tabs) Estilo Celeste -->
            <div class="grid grid-cols-2 gap-2 mt-4 bg-sky-900/20 p-1 rounded-xl backdrop-blur-md border border-white/20">
                <button onclick="switchTab(1)" id="tabBtn1" class="py-2 text-xs font-bold rounded-lg bg-white text-sky-700 transition shadow-sm flex items-center justify-center gap-1">
                    📋 1. Llenado ATS
                </button>
                <button onclick="switchTab(2)" id="tabBtn2" class="py-2 text-xs font-bold rounded-lg text-sky-100 transition hover:text-white flex items-center justify-center gap-1">
                    🏗️ 2. Campo y Cierre
                </button>
            </div>
        </header>

        <!-- Contenedor de Formulario -->
        <main class="p-4 flex-1 pb-24 overflow-y-auto space-y-4 bg-sky-50/50">
            
            <!-- ================= APARTADO 1: LLENADO DE ATS ================= -->
            <div id="tab1" class="tab-content active space-y-4">
                
                <!-- Datos del Inspector -->
                <div class="bg-white p-4 rounded-2xl border border-sky-100 shadow-sm space-y-3">
                    <div class="flex items-center gap-2 text-sky-700 font-bold text-xs uppercase tracking-wider">
                        <span>👤</span> Datos del Inspector / Evaluador
                    </div>
                    <div class="grid grid-cols-1 gap-2.5">
                        <div>
                            <label class="block text-[11px] font-semibold text-sky-900">Nombre del Inspector (SSOMA)</label>
                            <input type="text" id="inspectorNombre" placeholder="Ej. Yulisa Peralta" class="w-full mt-1 p-2.5 text-xs bg-sky-50/50 border border-sky-200 rounded-xl text-slate-800 placeholder-slate-400 focus:ring-2 focus:ring-sky-500 focus:outline-none">
                        </div>
                        <div>
                            <label class="block text-[11px] font-semibold text-sky-900">Cargo del Inspector</label>
                            <input type="text" id="inspectorCargo" placeholder="Ej. Asistente SSOMA / Ing. de Seguridad" class="w-full mt-1 p-2.5 text-xs bg-sky-50/50 border border-sky-200 rounded-xl text-slate-800 placeholder-slate-400 focus:ring-2 focus:ring-sky-500 focus:outline-none">
                        </div>
                    </div>
                </div>

                <!-- Datos Generales del Proyecto -->
                <div class="bg-white p-4 rounded-2xl border border-sky-100 shadow-sm space-y-3">
                    <div class="flex items-center gap-2 text-sky-700 font-bold text-xs uppercase tracking-wider">
                        <span>📍</span> Datos Generales de la Tarea
                    </div>
                    <div>
                        <label class="block text-[11px] font-semibold text-sky-900">Proyecto</label>
                        <input type="text" id="proyecto" placeholder="Nombre del proyecto..." class="w-full mt-1 p-2.5 text-xs bg-sky-50/50 border border-sky-200 rounded-xl text-slate-800 placeholder-slate-400 focus:ring-2 focus:ring-sky-500 focus:outline-none">
                    </div>
                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <label class="block text-[11px] font-semibold text-sky-900">Área</label>
                            <input type="text" id="area" placeholder="Área..." class="w-full mt-1 p-2.5 text-xs bg-sky-50/50 border border-sky-200 rounded-xl text-slate-800 placeholder-slate-400 focus:ring-2 focus:ring-sky-500 focus:outline-none">
                        </div>
                        <div>
                            <label class="block text-[11px] font-semibold text-sky-900">Código (CR)</label>
                            <input type="text" id="cr" placeholder="Ej. CR-01" class="w-full mt-1 p-2.5 text-xs bg-sky-50/50 border border-sky-200 rounded-xl text-slate-800 placeholder-slate-400 focus:ring-2 focus:ring-sky-500 focus:outline-none">
                        </div>
                    </div>
                    <div>
                        <label class="block text-[11px] font-semibold text-sky-900">Descripción del Trabajo</label>
                        <textarea id="descTrabajo" rows="2" placeholder="Describa la actividad..." class="w-full mt-1 p-2.5 text-xs bg-sky-50/50 border border-sky-200 rounded-xl text-slate-800 placeholder-slate-400 focus:ring-2 focus:ring-sky-500 focus:outline-none"></textarea>
                    </div>
                </div>

                <!-- Ítems 1 al 7 -->
                <div class="space-y-3">
                    <div class="flex items-center justify-between px-1">
                        <h2 class="text-xs font-bold text-sky-800 uppercase tracking-wider">Criterios Documentarios (Ítems 1-7)</h2>
                        <span class="text-[10px] bg-sky-100 text-sky-700 border border-sky-200 px-2 py-0.5 rounded-full font-bold">Escala 0 a 5</span>
                    </div>
                    <div id="questionsContainer1" class="space-y-3"></div>
                </div>

                <button onclick="switchTab(2)" class="w-full bg-gradient-to-r from-sky-500 to-blue-600 text-white font-bold py-3 rounded-xl text-xs shadow-md shadow-sky-500/25 active:scale-[0.99] transition flex items-center justify-center gap-2">
                    Siguiente: Evaluación en Campo &rarr;
                </button>
            </div>

            <!-- ================= APARTADO 2: CAMPO Y CIERRE ================= -->
            <div id="tab2" class="tab-content space-y-4">
                
                <div class="space-y-3">
                    <div class="flex items-center justify-between px-1">
                        <h2 class="text-xs font-bold text-sky-800 uppercase tracking-wider">Criterios de Campo (Ítems 8-11)</h2>
                        <span class="text-[10px] bg-sky-100 text-sky-700 border border-sky-200 px-2 py-0.5 rounded-full font-bold">Escala 0 a 5</span>
                    </div>
                    <div id="questionsContainer2" class="space-y-3"></div>
                </div>

                <!-- Tarjeta Resumen Visual en Celeste Intenso -->
                <div class="bg-gradient-to-br from-sky-600 to-blue-700 p-4 rounded-2xl text-white space-y-3 shadow-lg relative overflow-hidden">
                    <h2 class="text-[11px] font-bold text-sky-200 uppercase tracking-wider">📊 Resumen de Cumplimiento</h2>
                    <div class="flex justify-between items-center bg-black/15 p-3 rounded-xl border border-white/10">
                        <div>
                            <p class="text-xs text-sky-100">Puntaje: <span id="totalScore" class="font-black text-white text-base">0</span> <span class="text-[10px] text-sky-200">/ 55</span></p>
                            <p class="text-xs text-sky-100 mt-0.5">Nivel: <span id="percentage" class="font-extrabold text-amber-300">0.0%</span></p>
                        </div>
                        <div id="badgeLevel" class="px-3 py-1.5 bg-sky-800/80 text-sky-100 text-[10px] font-extrabold rounded-full uppercase tracking-wider border border-sky-400/30">
                            Sin Evaluar
                        </div>
                    </div>
                </div>

                <!-- Firmas y Responsables -->
                <div class="bg-white p-4 rounded-2xl border border-sky-100 shadow-sm space-y-3">
                    <div class="flex items-center gap-2 text-sky-700 font-bold text-xs uppercase tracking-wider">
                        <span>✍️</span> Firmas y Validación
                    </div>
                    <div>
                        <label class="block text-[11px] font-semibold text-sky-900">Supervisor de Producción / Jefe de Grupo</label>
                        <input type="text" id="supProduccion" placeholder="Nombre y Apellido" class="w-full mt-1 p-2.5 text-xs bg-sky-50/50 border border-sky-200 rounded-xl text-slate-800 placeholder-slate-400 focus:ring-2 focus:ring-sky-500 focus:outline-none">
                    </div>
                </div>

                <!-- Botones de Navegación Final -->
                <div class="flex gap-2 pt-2">
                    <button onclick="switchTab(1)" class="w-1/3 bg-sky-100 hover:bg-sky-200 text-sky-800 font-bold py-3 rounded-xl text-xs border border-sky-200 transition">
                        &larr; Volver
                    </button>
                    <button onclick="submitEvaluation()" class="w-2/3 bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white font-bold py-3 rounded-xl text-xs shadow-md shadow-emerald-600/25 transition flex items-center justify-center gap-1.5">
                        <span>💾</span> Guardar ATS
                    </button>
                </div>
            </div>

        </main>

        <!-- Footer -->
        <footer class="bg-sky-900 text-sky-200 border-t border-sky-800 p-3 text-center text-[10px]">
            Módulo SSOMA • Optimizado en Tonos Celestes
        </footer>

    </div>

    <!-- Script de Lógica -->
    <script>
        const questions = [
            // Apartado 1 (1-7)
            { id: 1, text: "¿La descripción del trabajo en el formato del ATS coincide con lo que se está desarrollando en el área?", section: 1 },
            { id: 2, text: "¿Se identificaron documentos de SST, EPP y EPC necesarios para iniciar el trabajo?", section: 1 },
            { id: 3, text: "¿El ATS incluye nombres y firmas de producción, jefe de grupo y supervisor SSOMA?", section: 1 },
            { id: 4, text: "¿Se identifican peligros directos de la tarea y los que rodean el área de trabajo?", section: 1 },
            { id: 5, text: "¿Se evalúan riesgos directos de la tarea y aquellos relacionados con el entorno?", section: 1 },
            { id: 6, text: "¿Se controlan adecuadamente todos los riesgos evaluados?", section: 1 },
            { id: 7, text: "¿El ATS incluye nombres y firmas de todos los trabajadores involucrados?", section: 1 },
            
            // Apartado 2 (8-11)
            { id: 8, text: "¿El jefe de grupo o capataz se reúne con el personal en el lugar para desarrollar el ATS?", section: 2 },
            { id: 9, text: "¿Los trabajadores reconocen y entienden los riesgos y controles descritos en el ATS?", section: 2 },
            { id: 10, text: "¿El personal comprende el objetivo y concepto del ATS?", section: 2 },
            { id: 11, text: "¿El ATS se encuentra ubicado visiblemente en el área de trabajo?", section: 2 }
        ];

        const scaleLabels = { 0: "No Existe", 1: "Muy Bajo", 2: "Bajo", 3: "Regular", 4: "Bueno", 5: "Muy Bueno" };
        const scores = {};

        const container1 = document.getElementById('questionsContainer1');
        const container2 = document.getElementById('questionsContainer2');

        questions.forEach((q, index) => {
            const card = document.createElement('div');
            card.className = "bg-white p-3.5 rounded-2xl border border-sky-100 shadow-sm space-y-2.5 transition hover:border-sky-300";
            card.innerHTML = `
                <div class="flex items-start gap-2.5">
                    <span class="bg-sky-500 text-white text-[11px] font-extrabold px-2 py-0.5 rounded-lg shadow-sm">${index + 1}</span>
                    <p class="text-xs font-semibold text-slate-800 leading-snug">${q.text}</p>
                </div>
                <!-- Botones de puntaje 0-5 -->
                <div class="grid grid-cols-6 gap-1.5 pt-1">
                    ${[0, 1, 2, 3, 4, 5].map(score => `
                        <button type="button" onclick="setScore(${q.id},${score})" id="q${q.id}_s${score}" 
                            class="score-btn-${q.id} border border-sky-200 rounded-xl py-1.5 text-xs font-bold text-sky-900 bg-sky-50/50 hover:bg-sky-100 transition">
                            ${score}
                        </button>
                    `).join('')}
                </div>
                <div class="flex justify-between items-center pt-1">
                    <input type="text" id="comentario_${q.id}" placeholder="Comentario u observación..." class="w-3/5 p-1.5 bg-sky-50/30 border border-sky-200 rounded-xl text-[11px] text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-1 focus:ring-sky-500">
                    <span id="desc_q${q.id}" class="text-[10px] text-sky-600 font-medium italic">Sin calificar</span>
                </div>
            `;

            if (q.section === 1) container1.appendChild(card);
            else container2.appendChild(card);
        });

        function switchTab(tabNumber) {
            document.getElementById('tab1').classList.remove('active');
            document.getElementById('tab2').classList.remove('active');
            
            document.getElementById('tabBtn1').className = "py-2 text-xs font-bold rounded-lg text-sky-100 transition hover:text-white flex items-center justify-center gap-1";
            document.getElementById('tabBtn2').className = "py-2 text-xs font-bold rounded-lg text-sky-100 transition hover:text-white flex items-center justify-center gap-1";

            if (tabNumber === 1) {
                document.getElementById('tab1').classList.add('active');
                document.getElementById('tabBtn1').className = "py-2 text-xs font-bold rounded-lg bg-white text-sky-700 transition shadow-sm flex items-center justify-center gap-1";
            } else {
                document.getElementById('tab2').classList.add('active');
                document.getElementById('tabBtn2').className = "py-2 text-xs font-bold rounded-lg bg-white text-sky-700 transition shadow-sm flex items-center justify-center gap-1";
            }
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function setScore(qid, score) {
            scores[qid] = score;
            
            for (let i = 0; i <= 5; i++) {
                const btn = document.getElementById(`q${qid}_s${i}`);
                if (i === score) {
                    btn.className = `score-btn-${qid} border border-sky-600 rounded-xl py-1.5 text-xs font-bold text-white bg-sky-600 shadow-md shadow-sky-500/30 transition scale-105`;
                } else {
                    btn.className = `score-btn-${qid} border border-sky-200 rounded-xl py-1.5 text-xs font-bold text-sky-900 bg-sky-50/50 hover:bg-sky-100 transition`;
                }
            }

            document.getElementById(`desc_q${qid}`).innerText = scaleLabels[score];
            calculateTotals();
        }

        function calculateTotals() {
            let total = 0;
            const count = Object.keys(scores).length;
            for (let key in scores) { total += scores[key]; }
            const percentage = (total / 55) * 100;

            document.getElementById('totalScore').innerText = total;
            document.getElementById('headerScore').innerText = total;
            document.getElementById('percentage').innerText = percentage.toFixed(1) + '%';

            const badge = document.getElementById('badgeLevel');
            if (count === 0) {
                badge.innerText = "Sin Evaluar";
                badge.className = "px-3 py-1.5 bg-sky-800/80 text-sky-100 text-[10px] font-extrabold rounded-full uppercase tracking-wider border border-sky-400/30";
            } else if (percentage >= 90) {
                badge.innerText = "Muy Bueno";
                badge.className = "px-3 py-1.5 bg-emerald-500 text-white text-[10px] font-extrabold rounded-full uppercase tracking-wider shadow-sm";
            } else if (percentage >= 75) {
                badge.innerText = "Bueno";
                badge.className = "px-3 py-1.5 bg-sky-500 text-white text-[10px] font-extrabold rounded-full uppercase tracking-wider shadow-sm";
            } else if (percentage >= 60) {
                badge.innerText = "Regular";
                badge.className = "px-3 py-1.5 bg-amber-500 text-white text-[10px] font-extrabold rounded-full uppercase tracking-wider shadow-sm";
            } else if (percentage >= 40) {
                badge.innerText = "Bajo";
                badge.className = "px-3 py-1.5 bg-orange-500 text-white text-[10px] font-extrabold rounded-full uppercase tracking-wider shadow-sm";
            } else {
                badge.innerText = "Crítico";
                badge.className = "px-3 py-1.5 bg-rose-600 text-white text-[10px] font-extrabold rounded-full uppercase tracking-wider shadow-sm";
            }
        }

        function submitEvaluation() {
            const inspector = document.getElementById('inspectorNombre').value;
            const proyecto = document.getElementById('proyecto').value;
            
            if (!inspector) {
                alert("Por favor ingrese el nombre del Inspector en el Apartado 1.");
                switchTab(1);
                return;
            }
            if (!proyecto) {
                alert("Por favor ingrese el nombre del proyecto en el Apartado 1.");
                switchTab(1);
                return;
            }
            if (Object.keys(scores).length < 11) {
                alert("Faltan preguntas por calificar. Revisa ambos apartados.");
                return;
            }
            alert(`¡Excelente! Evaluación registrada con éxito por: ${inspector}.`);
        }
    </script>
</body>
</html>
