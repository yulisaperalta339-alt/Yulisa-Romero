<!doctype html><html lang="es"><head><meta name="ms-sp-authoring-source" content="agent"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Misión SST - Andamio</title><style>
:root{--y:#ffd12e;--c:#13b9d1;--g:#20a56b;--r:#ef4255;--n:#071722}*{box-sizing:border-box}body{margin:0;font-family:Segoe UI,Arial;background:#091a27;color:#fff;overflow:hidden}.screen{display:none;min-height:100vh}.screen.active{display:flex}.center{align-items:center;justify-content:center;background:radial-gradient(circle at 70% 20%,#15516a,#071722 58%)}.card{width:min(800px,94vw);background:#fff;color:#173447;border-radius:24px;padding:32px;text-align:center;box-shadow:0 25px 70px #0009}.tag{display:inline-block;padding:7px 11px;border-radius:99px;background:#e4f7fa;color:#08778a;font-weight:900;font-size:12px}.btn{border:0;border-radius:11px;padding:13px 17px;font-weight:800;cursor:pointer}.primary{background:var(--y);color:#152533}.secondary{background:#def3f6;color:#086e80}input{width:100%;padding:12px;border:2px solid #ccdde2;border-radius:10px;font:inherit}form{display:grid;gap:12px;text-align:left;max-width:520px;margin:20px auto}#game{flex-direction:column}header{height:76px;display:flex;align-items:center;justify-content:space-between;padding:10px 18px;background:var(--n);z-index:20}header h2{margin:0}.stats{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.pill{background:#173548;padding:8px 11px;border-radius:11px;font-weight:800;color:#fff;border:0}.music{cursor:pointer}.app{display:grid;grid-template-columns:1fr 300px;height:calc(100vh - 76px)}.view{position:relative;overflow:hidden;background:#111;touch-action:none;cursor:grab}.world{position:absolute;inset:0;transform-origin:0 0}.world img{width:100%;height:100%;object-fit:contain;pointer-events:none;user-select:none}.spot{position:absolute;width:34px;height:34px;margin:-17px;border:3px solid white;border-radius:50%;background:#ef4255dd;color:white;font-weight:900;cursor:pointer;box-shadow:0 0 0 8px #ef425544;animation:p 1.4s infinite}.spot.done{background:var(--g);animation:none}@keyframes p{50%{box-shadow:0 0 0 14px transparent}}.controls{position:absolute;right:15px;bottom:15px;display:grid;gap:7px}.controls button{width:45px;height:45px;border:0;border-radius:10px;font-size:22px}.tip{position:absolute;left:15px;top:15px;background:#071722dd;padding:10px;border-radius:10px;z-index:2}.side{background:#f7fbfc;color:#173447;padding:18px;overflow:auto}.bar{height:7px;background:#d7e4e8;border-radius:7px;overflow:hidden}.bar i{display:block;height:100%;width:0;background:var(--c)}#foundList{padding-left:21px;font-size:13px}dialog{border:0;border-radius:20px;padding:27px;width:min(540px,94vw);color:#173447}dialog::backdrop{background:#061521c8}.answers{display:grid;gap:9px}.ans{border:2px solid #d2e0e4;background:#fff;color:#173447;padding:12px;text-align:left;border-radius:10px;cursor:pointer}.ans.good{background:#e5f8ef;border-color:var(--g)}.ans.bad{background:#ffedf0;border-color:var(--r);text-decoration:line-through}.msg{min-height:42px;font-weight:800}.ok{color:#168153}.no{color:#c52239}.podium{display:flex;align-items:end;justify-content:center;gap:10px;min-height:140px}.place{width:30%;padding:12px 5px;background:#e7f2f5;border-radius:12px 12px 0 0}.p1{min-height:130px;background:#ffe895}.p2{min-height:100px}.p3{min-height:80px;background:#f3d3b7}table{width:100%;border-collapse:collapse;font-size:13px}th,td{padding:8px;border-bottom:1px solid #dce7ea;text-align:left}.mission{position:fixed;top:92px;left:50%;transform:translateX(-50%);background:#111;border:2px solid var(--y);padding:13px 22px;z-index:99;opacity:0;transition:.2s;font-weight:900}.mission.show{opacity:1}@media(max-width:800px){.app{grid-template-columns:1fr}.side{display:none}.stats{font-size:12px}.podium{flex-direction:column;align-items:stretch}.place{width:100%;min-height:auto}}</style></head><body>
<section id="register" class="screen center active"><div class="card"><span class="tag">REGISTRO</span><h1>Misión SST: Andamio colgante</h1><form id="reg"><label>Nombre o código<input id="name" required maxlength="60"></label><label>Proyecto o frente<input id="project" required maxlength="60"></label><button class="btn primary">Ingresar</button><button type="button" id="repoStart" class="btn secondary">Ver podio y repositorio</button></form><small>Los registros se guardan localmente en este navegador. Para un repositorio compartido entre dispositivos se requiere un backend.</small></div></section>
<section id="intro" class="screen center"><div class="card"><span class="tag">MISIÓN DE INSPECCIÓN</span><h1>Encuentra 10 observaciones</h1><p>Haz zoom y recorre la fotografía. El reto está centrado en los dos andamios, las personas y sus protecciones. No se califican los rollos de alambre.</p><p><b>Por cada hallazgo:</b> 2 preguntas específicas: riesgo y control. Hay 2 intentos por pregunta. Acierto +100 XP, error −50 XP.</p><button id="start" class="btn primary">Iniciar misión</button></div></section>
<section id="game" class="screen"><header><div><small>MISIÓN SST</small><h2>Inspección de andamios</h2></div><div class="stats"><span class="pill" id="count">0/10</span><span class="pill" id="zoom">100%</span><span class="pill"><b id="xp">0</b> XP</span><span class="pill">Errores <b id="errors">0</b></span><button id="music" class="pill music">🔇 Música</button></div></header><main class="app"><div class="view" id="view"><div class="tip">🖐 Arrastra · 🔍 Zoom · 🎯 Selecciona</div><div id="world" class="world"><img src="data:image/jpeg;base64," alt="Zona de trabajo en altura con dos andamios suspendidos"><div id="spots"></div></div><div class="controls"><button id="plus">+</button><button id="minus">−</button><button id="reset">⌂</button></div></div><aside class="side"><h3>Hallazgos</h3><div class="bar"><i id="bar"></i></div><ol id="foundList"><li>Aún no hay hallazgos.</li></ol><button id="hint" class="btn secondary">Enfocar pendiente</button></aside></main></section>
<section id="result" class="screen center"><div class="card"><div style="font-size:55px">🏆</div><h1>Misión completada</h1><p id="summary"></p><button id="repoResult" class="btn secondary">Ver podio y repositorio</button> <button id="again" class="btn primary">Nuevo participante</button> <button id="resetResult" class="btn secondary">Reiniciar y borrar podio</button></div></section>
<dialog id="foundDlg"><span class="tag">OBSERVACIÓN CORRECTA</span><h2 id="foundTitle"></h2><p id="foundDetail"></p><button id="accept" class="btn primary">Responder 2 preguntas</button></dialog>
<dialog id="quiz"><div style="display:flex;justify-content:space-between"><span class="tag">DESAFÍO SST</span><b id="qprog">1/2</b><b id="tries">Intentos 2/2</b></div><h2 id="qtitle"></h2><p id="qtext"></p><div id="answers" class="answers"></div><p id="msg" class="msg"></p><button id="next" class="btn primary" disabled>Siguiente</button></dialog>
<dialog id="repo" style="width:min(880px,95vw)"><button id="closeRepo" style="float:right;border:0;background:none;font-size:24px">×</button><span class="tag">REPOSITORIO LOCAL</span><h2>Podio de participantes</h2><div id="podium" class="podium"></div><div style="overflow:auto"><table><thead><tr><th>#</th><th>Participante</th><th>Proyecto</th><th>XP</th><th>Errores</th><th>Fecha</th></tr></thead><tbody id="rows"></tbody></table></div><p><button id="csv" class="btn secondary">Exportar CSV</button> <button id="resetAll" class="btn primary">Reiniciar juego y borrar podio</button></p></dialog><div id="mission" class="mission">MISIÓN COMPLETADA</div>
<script>
const obs=[
{id:1,t:'Materiales sueltos en el acceso al andamio cercano',x:19,y:62,d:'Hay materiales próximos al acceso y al borde.',risk:'Tropiezo y caída al mismo o distinto nivel',control:'Retirar y asegurar materiales, manteniendo libre el acceso'},
{id:2,t:'Residuos en la ruta de acceso',x:29,y:82,d:'La ruta estrecha presenta residuos.',risk:'Pérdida de equilibrio al acceder a la plataforma',control:'Aplicar orden y limpieza antes y durante la tarea'},
{id:3,t:'Protección de borde junto al área de inspección',x:32,y:52,d:'El puesto está junto a un desnivel.',risk:'Caída a distinto nivel por protección insuficiente',control:'Verificar continuidad, altura y resistencia de la protección colectiva'},
{id:4,t:'Conexión anticaídas junto al borde',x:31,y:46,d:'La conexión del sistema personal requiere inspección cercana.',risk:'Caída sin detención efectiva',control:'Conectar a un anclaje autorizado e independiente'},
{id:5,t:'Elemento suspendido junto al borde',x:36,y:52,d:'Se aprecia un recipiente o elemento colgante.',risk:'Caída de objeto sobre personas o equipos',control:'Asegurar recipientes y herramientas contra caída'},
{id:6,t:'Protección lateral del andamio cercano',x:53,y:67,d:'La protección lateral debe revisarse en conjunto.',risk:'Caída desde la plataforma',control:'Verificar barandilla superior, intermedia y rodapié'},
{id:7,t:'Ajuste del arnés en el andamio cercano',x:58,y:74,d:'Las bandas del arnés son visibles.',risk:'Detención ineficaz o lesión durante una caída',control:'Comprobar ajuste, hebillas, conexión y ausencia de torsiones'},
{id:8,t:'Protección lateral del andamio de enfrente',x:72,y:36,d:'La plataforma opuesta requiere revisión de bordes.',risk:'Caída desde el andamio opuesto',control:'Completar y verificar barandillas y rodapiés antes del uso'},
{id:9,t:'Posición en el extremo del andamio de enfrente',x:67,y:31,d:'La posición está próxima al extremo de la plataforma.',risk:'Pérdida de equilibrio y caída desde el extremo',control:'Mantener postura estable y conexión independiente'},
{id:10,t:'Nivelación del andamio de enfrente',x:78,y:34,d:'La condición general de la plataforma debe revisarse.',risk:'Inclinación o inestabilidad de la plataforma',control:'Verificar nivelación, capacidad, acceso y protecciones antes de operar'}];
const dec={risk:['Demora administrativa','Cambio de color en la fachada'],control:['Continuar si la tarea es breve','Dar únicamente una advertencia verbal']};
let found=new Set(),pending=null,q=0,tries=2,xp=0,errors=0,player={},scale=1,tx=0,ty=0,drag=false,sx=0,sy=0,ctx=null,gain=null,musicTimer=null,musicOn=false,saved=false;
const $=x=>document.querySelector(x),show=id=>document.querySelectorAll('.screen').forEach(s=>s.classList.toggle('active',s.id===id));
$('#reg').onsubmit=e=>{e.preventDefault();player={name:$('#name').value.trim(),project:$('#project').value.trim()};show('intro')};$('#start').onclick=setup;$('#again').onclick=()=>show('register');
function setup(){found.clear();pending=null;q=0;xp=errors=0;saved=false;scale=1;tx=ty=0;$('#spots').innerHTML='';obs.forEach(o=>{let b=document.createElement('button');b.className='spot';b.style.left=o.x+'%';b.style.top=o.y+'%';b.textContent='!';b.onclick=e=>{e.stopPropagation();inspect(o,b)};$('#spots').append(b)});update();transform();show('game')}
function inspect(o,b){if(scale<1.5)return alert('Acércate como mínimo a 150%');if(found.has(o.id)||pending)return;pending={o,b};$('#foundTitle').textContent=o.t;$('#foundDetail').textContent=o.d;$('#foundDlg').showModal()}
$('#accept').onclick=()=>{$('#foundDlg').close();q=0;question()};
function question(){tries=2;let o=pending.o,key=q===0?'risk':'control',correct=o[key];$('#qprog').textContent=(q+1)+'/2';$('#tries').textContent='Intentos 2/2';$('#qtitle').textContent=o.t;$('#qtext').textContent=q===0?'¿Cuál sería el riesgo principal?':'¿Cuál sería el control más adecuado?';$('#msg').textContent='';$('#next').disabled=true;let a=[correct,...dec[key]].sort(()=>Math.random()-.5);$('#answers').innerHTML='';a.forEach(v=>{let b=document.createElement('button');b.className='ans';b.textContent=v;b.onclick=()=>answer(b,v===correct,correct);$('#answers').append(b)});$('#quiz').showModal()}
function answer(b,ok,correct){if(ok){document.querySelectorAll('.ans').forEach(x=>x.disabled=true);b.classList.add('good');$('#msg').innerHTML='✅ CORRECTO · +100 XP';$('#msg').className='msg ok';xp+=100;sfx(true);$('#next').disabled=false}else{tries--;errors++;xp=Math.max(0,xp-50);b.disabled=true;b.classList.add('bad');sfx(false);$('#tries').textContent='Intentos '+tries+'/2';$('#msg').innerHTML=tries?'❌ INCORRECTO · −50 XP · Intenta otra vez':'❌ INTENTOS AGOTADOS · Respuesta correcta en verde';$('#msg').className='msg no';if(!tries){document.querySelectorAll('.ans').forEach(x=>{x.disabled=true;if(x.textContent===correct)x.classList.add('good')});$('#next').disabled=false}}update()}
$('#next').onclick=()=>{$('#quiz').close();q++;if(q<2)return question();let {o,b}=pending;found.add(o.id);b.classList.add('done');b.textContent='✓';pending=null;update();let m=$('#mission');m.classList.add('show');setTimeout(()=>m.classList.remove('show'),1300)};
function update(){$('#count').textContent=found.size+'/10';$('#xp').textContent=xp;$('#errors').textContent=errors;$('#bar').style.width=found.size*10+'%';$('#foundList').innerHTML=found.size?'':'<li>Aún no hay hallazgos.</li>';obs.filter(o=>found.has(o.id)).forEach(o=>{let li=document.createElement('li');li.textContent=o.t;$('#foundList').append(li)});if(found.size===10&&!saved){saved=true;save();$('#summary').textContent=player.name+' obtuvo '+xp+' XP con '+errors+' errores.';setTimeout(()=>show('result'),500)}}
const view=$('#view'),world=$('#world');function transform(){tx=Math.min(0,Math.max(view.clientWidth-view.clientWidth*scale,tx));ty=Math.min(0,Math.max(view.clientHeight-view.clientHeight*scale,ty));world.style.transform=`translate(${tx}px,${ty}px) scale(${scale})`;$('#zoom').textContent=Math.round(scale*100)+'%'}function zoom(n){scale=Math.max(1,Math.min(4,n));transform()}$('#plus').onclick=()=>zoom(scale*1.3);$('#minus').onclick=()=>zoom(scale/1.3);$('#reset').onclick=()=>{scale=1;tx=ty=0;transform()};view.onwheel=e=>{e.preventDefault();zoom(scale*(e.deltaY<0?1.15:.87))};view.onpointerdown=e=>{if(e.target.classList.contains('spot'))return;drag=true;sx=e.clientX-tx;sy=e.clientY-ty};view.onpointermove=e=>{if(drag){tx=e.clientX-sx;ty=e.clientY-sy;transform()}};view.onpointerup=()=>drag=false;$('#hint').onclick=()=>{let o=obs.find(x=>!found.has(x.id));if(!o)return;scale=2.2;tx=view.clientWidth/2-o.x/100*view.clientWidth*scale;ty=view.clientHeight/2-o.y/100*view.clientHeight*scale;transform()};
function audio(){if(!ctx){ctx=new(window.AudioContext||window.webkitAudioContext)();gain=ctx.createGain();gain.gain.value=.55;gain.connect(ctx.destination)}ctx.resume()}function tone(f,d,type='sine',vol=.06,at=0){audio();let o=ctx.createOscillator(),g=ctx.createGain(),t=ctx.currentTime+at;o.type=type;o.frequency.value=f;g.gain.setValueAtTime(.001,t);g.gain.exponentialRampToValueAtTime(vol,t+.02);g.gain.exponentialRampToValueAtTime(.001,t+d);o.connect(g);g.connect(gain);o.start(t);o.stop(t+d+.03)}function sfx(ok){if(ok){tone(523,.12,'sine',.08);tone(659,.14,'sine',.08,.11);tone(784,.23,'triangle',.09,.22)}else{tone(180,.18,'sawtooth',.08);tone(110,.28,'square',.05,.12)}}function beat(){if(!musicOn)return;tone([55,65,73,65][Date.now()%4],.28,'triangle',.025)}$('#music').onclick=()=>{musicOn=!musicOn;$('#music').textContent=musicOn?'🔊 Música':'🔇 Música';if(musicOn){audio();beat();musicTimer=setInterval(beat,420)}else clearInterval(musicTimer)};
function repo(){try{return JSON.parse(localStorage.getItem('sstRepo')||'[]')}catch{return[]}}function save(){let r=repo();r.push({name:player.name,project:player.project,xp,errors,date:new Date().toLocaleString('es-PE')});localStorage.setItem('sstRepo',JSON.stringify(r))}function openRepo(){let r=repo().sort((a,b)=>b.xp-a.xp||a.errors-b.errors);$('#rows').innerHTML=r.length?'':'<tr><td colspan="6">Sin registros en este navegador.</td></tr>';r.forEach((x,i)=>{$('#rows').innerHTML+=`<tr><td>${i+1}</td><td>${esc(x.name)}</td><td>${esc(x.project)}</td><td>${x.xp}</td><td>${x.errors}</td><td>${x.date}</td></tr>`});$('#podium').innerHTML='';[1,0,2].forEach(i=>{let x=r[i],d=document.createElement('div');d.className='place p'+(i+1);d.innerHTML=x?`<b>${i===0?'🥇':i===1?'🥈':'🥉'} ${i+1}°</b><br>${esc(x.name)}<br><small>${x.xp} XP</small>`:`<b>${i+1}°</b><br>Vacante`;$('#podium').append(d)});$('#repo').showModal()}function esc(v){let d=document.createElement('div');d.textContent=v;return d.innerHTML}$('#repoStart').onclick=openRepo;$('#repoResult').onclick=openRepo;$('#closeRepo').onclick=()=>$('#repo').close();function resetGameAndPodium(){if(!confirm('¿Deseas reiniciar el juego y borrar permanentemente todos los registros del podio en este navegador?'))return;localStorage.removeItem('sstRepo');found.clear();pending=null;q=0;tries=2;xp=0;errors=0;saved=false;scale=1;tx=0;ty=0;player={};if($('#repo').open)$('#repo').close();$('#name').value='';$('#project').value='';update();show('register')}$('#resetAll').onclick=resetGameAndPodium;$('#resetResult').onclick=resetGameAndPodium;$('#csv').onclick=()=>{let r=repo(),csv=['Participante,Proyecto,XP,Errores,Fecha',...r.map(x=>[x.name,x.project,x.xp,x.errors,x.date].map(v=>'"'+String(v).replaceAll('"','""')+'"').join(','))].join('\n'),a=document.createElement('a');a.href=URL.createObjectURL(new Blob([csv],{type:'text/csv'}));a.download='repositorio_sst.csv';a.click()};
</script></body></html>
